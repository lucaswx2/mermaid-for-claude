node_modules/
*.log
.DS_Store
# The Windows console width probe is compiled into the cache directory outside the plugin (ADR-0008);
# the plugin ships hooks/console-width.cs and never a binary. Scoped to that one directory so a stray
# build artefact anywhere else still shows up in git status and in CI's check on dist/.
hooks/*.exe
# Prototypes live on their own prototype/<name> branches and are never tracked on
# main; what lands here is generated by a prototype's own build (build.mjs writes
# bundle.mjs) or by running it. Scoped to those paths, so an unexpected stray
# under prototype/ still shows up in git status.
prototype/*/node_modules/
prototype/*/cache/
prototype/*/bundle.mjs
