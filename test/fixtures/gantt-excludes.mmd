gantt
    dateFormat YYYY-MM-DD
    axisFormat %d
    tickInterval 1day
    excludes weekends
    Thursday start :a, 2024-01-04, 3d
    After a        :b, after a, 1d
    Friday start   :c, 2024-01-05, 3d
    Ends Saturday  :d, 2024-01-04, 2d
    After d        :e, after d, 1d
    Tail           :f, 2024-01-10, 1d
